{
  "manifest_version": 3,
  "name": "Revisor Visual",
  "version": "1.1.1",
  "description": "Marca elementos de uma pagina e exporta os comentarios como prompt pronto para o Claude Code.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "shared.js",
      "db.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Revisor Visual (Alt+Shift+R)",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "commands": {
    "toggle-review": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Ligar ou desligar o modo de revisao"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "revisor-visual@matheuservilha.github.io",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
